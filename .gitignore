# --- Python (app/backend) ---
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
htmlcov/

# --- Node / Next.js (app/frontend) ---
node_modules/
.next/
out/
build/
.turbo/
*.tsbuildinfo
npm-debug.log*
yarn-error.log*
pnpm-debug.log*

# --- 환경 변수 / 자격 증명 ---
# AWS_BEARER_TOKEN_BEDROCK, DATABASE_URL 등은 절대 커밋하지 않는다.
.env
.env.*
!.env.example

# --- 로컬 데이터 ---
# 음성 녹음은 opt-in이며 저장소에 넣지 않는다.
assets/audio/
data/local/
*.dump

# --- OS / 편집기 ---
.DS_Store
.vscode/
.idea/
*.swp

# --- Claude Code 프로젝트 설정 (2026-09-08) ---
# settings.json 만 공유한다 — 나머지는 로컬·런타임 상태다.
.claude/settings.local.json
.claude/settings.local.json.bak*
.claude/scheduled_tasks.json
.claude/scheduled_tasks.lock
# 에이전트 파일은 커밋하지 않는다 (TASK-17 캡틴 결정).
# 절차 정본은 추적되는 tests/harness/browser_leg.md 다.
.claude/agents/
