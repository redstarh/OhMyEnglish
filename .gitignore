htmlcov/

# --- Node / Next.js (app/frontend) ---
node_modules/
.next/
out/
build/
.turbo/
*.tsbuildinfo
npm-debug.log*
yarn-error.log*
pnpm-debug.log*

# --- 환경 변수 / 자격 증명 ---
# AWS_BEARER_TOKEN_BEDROCK, DATABASE_URL 등은 절대 커밋하지 않는다.
.env
.env.*
!.env.example

# --- 로컬 데이터 ---
# 음성 녹음은 opt-in이며 저장소에 넣지 않는다.
assets/audio/
data/local/
*.dump

# --- OS / 편집기 ---
.DS_Store
.vscode/
.idea/
*.swp

# --- Claude Code 프로젝트 설정 (2026-09-08) ---
# settings.json 만 공유한다 — 나머지는 로컬·런타임 상태다.
.claude/settings.local.json
.claude/settings.local.json.bak*
.claude/scheduled_tasks.json
.claude/scheduled_tasks.lock
# 에이전트 파일은 커밋하지 않는다 (TASK-17 캡틴 결정).
# 절차 정본은 추적되는 tests/harness/browser_leg.md 다.
.claude/agents/

# --- 모바일 원격 접속 앱 Paseo (2026-09-16) ---
# 사용자가 설치한 Paseo 앱이 리포 디렉터리에 만드는 설정 파일이다 — 리포 코드가 아니다.
# ⛔ 지우지 않는다: 그 도구가 쓰는 파일이고 여기서는 추적만 하지 않는다.
# ⚠️ 이 한 줄이 원장 게이트(G1)의 반복 차단을 끝낸다 — 미추적 변경이 In Progress 태스크 0건과
#    겹치면 훅이 「원장에 없는 작업」으로 읽는데, 그 파일은 작업이 아니다.
paseo.json

# DB 덤프 — 학습 데이터가 담기므로 추적하지 않는다 (TASK-205 · 적용 전 백업)
db/backups/
