# Copy to app/frontend/.env.local for local development.
#
# 백엔드 주소를 하드코딩하지 않기 위한 환경변수.
#
# ⚠️ 이 값을 반드시 설정하라. `lib/config.ts`의 폴백은 `http://localhost:8000`인데,
#    이 개발 머신의 :8000은 **다른 프로젝트(StockAgent)**가 쓰고 있다(2026-08-26 실측:
#    :8000 openapi title = "StockAgent (MOCK)"). 폴백에 기대면 프론트가 엉뚱한
#    백엔드에 붙어 결과 조회가 조용히 실패한다.
#
# OhMyEnglish 백엔드는 :8002로 띄운다:
#   cd app/backend && .venv/bin/uvicorn app.api.main:app --port 8002
NEXT_PUBLIC_API_BASE=http://localhost:8002
