# Copy this file to app/backend/.env for local development
# (Settings() reads `.env` relative to the backend process's cwd).
# Never commit the real .env — see .gitignore.

# :5432 = homebrew postgresql@17 (부팅 시 자동 기동). 폴백은 podman :5433 (`scripts/dev_db.sh start`).
DATABASE_URL=postgresql://ohmy:ohmy@localhost:5432/ohmyenglish
AWS_REGION=us-west-2
AWS_BEARER_TOKEN_BEDROCK=
CLAUDE_MODEL_ID=us.anthropic.claude-opus-5
# 발화 종료 감지 시점 (Nova). HIGH(빠름) / MEDIUM(기본) / LOW(느림).
# 2026-09-01 실물 마이크 1회에서 MEDIUM이 **1.05~2.54초 침묵**에 문장을 끊어
# 내 발화 18건 중 4건이 문장 중간에 쪼개졌다("i'm going to" / "have a meeting") → LOW 권장.
NOVA_ENDPOINTING_SENSITIVITY=LOW
# 분석 워커 기동 플래그. false면 API만 뜨고 큐가 쌓인다 (E2E-S 3단계).
WORKER_ENABLED=true
# 드릴당 exchange 수의 하한 — 요구사항이 명시한 값(드릴마다 4턴 이상).
DRILL_TURNS_MIN=4
# 드릴 수의 상한(min(질문 수, DRILL_COUNT)) — 캡틴 결정 1(드릴 횟수는 설정값).
# 기본 5는 캡틴 결정 17 — 지시문이 questions[:DRILL_COUNT]만 열거하므로 3이면 질문 4~5개인
# 계획의 질문이 대화에 도달하지 않는다(결정 2가 "질문 3~5개를 전달한다"고 정했다).
# 낮추면 지시문의 열거와 기대 exchange 수가 **함께** 줄어든다 — 통과 문턱만 바뀌지 않는다.
DRILL_COUNT=5
# 쉐도잉 재생 속도 — 캡틴 결정 6이 0.5~2.0배로 값역을 정했다. 범위 밖은 **기동 시점에 거부된다**.
# 기본 1.0은 값역의 항등원이다: 설정이 생기는 것만으로 재생이 달라지지 않게 한다.
SHADOWING_PLAYBACK_RATE=1.0
# 쉐도잉 반복 횟수 — 캡틴 결정 6이 1~10회로 정했다. 기본 1도 같은 이유의 항등원이다.
# 낮추면 코치 지시문의 "각 문장을 N회 따라 말하게 한다"가 함께 줄어든다 — 실제 연습량이 준다.
SHADOWING_REPEAT_COUNT=1
# 학습자 낭독 녹음의 뿌리. 백엔드 cwd(app/backend) 기준 상대경로다.
# ⛔ ../../ 인 것은 편의가 아니라 추적 회피다 — .gitignore 의 assets/audio/ 는 슬래시를 포함해
#    리포루트에만 앵커되므로 app/backend/assets/audio/ 는 추적 대상이 된다(녹음이 git 에 들어간다).
SHADOWING_AUDIO_ROOT=../../assets/audio
