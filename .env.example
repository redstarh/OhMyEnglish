# Copy this file to app/backend/.env for local development
# (Settings() reads `.env` relative to the backend process's cwd).
# Never commit the real .env — see .gitignore.

DATABASE_URL=postgresql://ohmy:ohmy@localhost:5433/ohmyenglish
AWS_REGION=us-west-2
AWS_BEARER_TOKEN_BEDROCK=
CLAUDE_MODEL_ID=us.anthropic.claude-opus-5
# 분석 워커 기동 플래그. false면 API만 뜨고 큐가 쌓인다 (E2E-S 3단계).
WORKER_ENABLED=true
